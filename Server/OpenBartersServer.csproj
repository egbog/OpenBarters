<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<Version>0.0.1</Version>
    <OutputType>Library</OutputType>
	<RootNamespace>_OpenBarters</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<!-- The two lines below will set the output path for the binaries -->
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)-$(Version)\\</OutputPath>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
	<Configurations>Debug;Release;Source-Debug</Configurations>
  </PropertyGroup>
  
    <!-- Allow go to declaration using project source instead of decompiled source -->
  <ItemGroup Condition="'$(Configuration)'=='Source-Debug'">
    <ProjectReference Include="..\..\server-csharp\Libraries\SPTushonka.Server.Core\SPTushonka.Server.Core.csproj" />
    <ProjectReference Include="..\..\server-csharp\Libraries\SPTushonka.Common\SPTushonka.Common.csproj" />
    <ProjectReference Include="..\..\server-csharp\Libraries\SPTushonka.DI\SPTushonka.DI.csproj" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(Configuration)'!='Source-Debug'">
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.3" />
    <PackageReference Include="SPTushonka.Common" Version="4.1.3" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.3" />
  </ItemGroup>
  
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="PowerShell.exe -ExecutionPolicy Bypass -File &quot;$(ProjectDir)\PostBuild.ps1&quot; -Configuration &quot;$(ConfigurationName)&quot;" />
  </Target>

</Project>
